# ODYSS3D — Configuración de entorno
# Copia este archivo a .env.local y completa tus valores reales.
# NUNCA subas .env.local a GitHub.

# Panel administrativo — Supabase
# Este proyecto es Next.js (no Vite), por lo que las variables públicas
# visibles en el navegador deben tener el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio de Supabase — SOLO se usa en el servidor (scripts y API routes).
# NUNCA debe estar disponible en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Contraseña inicial de las cuentas cami / sebas (solo para el script de creación)
ADMIN_INITIAL_PASSWORD=

# Correo de cotizaciones (página /contacto)
# Opción A (recomendada): Resend (gratis) — key en resend.com
RESEND_API_KEY=
RESEND_TO=odyss3d@hotmail.com
# Dejar vacío para usar onboarding@resend.dev
# RESEND_FROM=

# Opción B (SMTP): algunos proveedores (ej. Hotmail) bloquean SMTP con App Password.
# Solo útil si tu proveedor lo permite.
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASS=
# MAIL_TO=odyss3d@hotmail.com

# Página /ia — IA para generar modelo 3D desde una imagen (Tripo).
# Key en platform.tripo3d.ai → API Keys. Solo se usa en el servidor.
TRIPO_API_KEY=